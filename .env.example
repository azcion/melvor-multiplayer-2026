# Optional host port; the server listens on port 3000 inside its container.
MELVOR_SERVER_PORT=3000

# Comma-separated game origins permitted to call the API.
MELVOR_CORS_ALLOWED_ORIGINS=https://melvoridle.com,https://play.melvoridle.com,https://ios.melvoridle.com,https://android.melvoridle.com

# Trust Cloudflare's CF-Connecting-IP header only when cloudflared is the sole public route to the loopback-bound port.
MELVOR_TRUST_PROXY=0

# Request, identity, and registration boundaries for a small self-hosted service.
MELVOR_MAX_JSON_BODY_BYTES=32768
MELVOR_REQUEST_SOURCE_PER_MINUTE=120
MELVOR_REQUEST_SOURCE_BURST=30
MELVOR_REQUEST_IDENTITY_PER_MINUTE=60
MELVOR_REQUEST_IDENTITY_BURST=20
MELVOR_REGISTRATIONS_PER_SOURCE_HOUR=4
MELVOR_REGISTRATIONS_PER_SERVICE_HOUR=32

# Keep authentication and registration responses uniformly delayed outside isolated automated tests.
MELVOR_AUTH_RESPONSE_DELAY_MS=1000
# Comma-separated authenticated multiplayer Client identifiers for Support Team access. Keep real identifiers only in
# local deployment configuration.
MELVOR_SUPPORT_TEAM_CLIENT_IDENTIFIERS=

# Application logs are disabled by default. Enable them only with an appropriate retention policy.
MELVOR_FILE_OPERATIONAL_LOGS=0
MELVOR_LOG_DIR=./logs
MELVOR_DOCKER_LOG_DRIVER=local

# Consistent SQLite backups can be written outside the live database volume.
MELVOR_BACKUP_DIR=./backups
MELVOR_BACKUP_DAILY_RETENTION_COUNT=7
MELVOR_BACKUP_NON_DAILY_RETENTION_COUNT=14
MELVOR_BACKUP_NON_DAILY_RETENTION_DAYS=30

# Fail the host health check when aggregate backup storage reaches this size.
MELVOR_MONITOR_BACKUP_BYTES=2147483648
